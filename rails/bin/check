#!/usr/bin/env ruby

def system!(*args)
  system(*args, exception: true)
end

[
  "bin/rails zeitwerk:check",
  "make -C /workspace fmt",
  "yarn eslint . --fix",
  "bin/erb_lint --lint-all",
  "bin/standardrb",
  "bin/rspec"
].each do |command|
  puts "=== `#{command}` を実行中..."
  system!(command)
end
