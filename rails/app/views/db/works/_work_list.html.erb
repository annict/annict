<% return_to_query = {return_to: request.fullpath}.to_query %>
<table class="table table-sm">
  <thead>
    <tr>
      <th>
        ID
      </th>
      <th style="width: 45%;">
        <%= t "noun.title" %>
      </th>
      <th>
        <%= t "noun.external_services" %>
      </th>
      <th>
        Watchers
      </th>
      <th>
        <%= t "noun.release_season" %>
      </th>
      <th>
        <%= t "noun.work_image" %>
      </th>
      <th>
        <%= t "noun.state" %>
      </th>
      <th>
        <%= t "noun.actions" %>
      </th>
    </tr>
  </thead>
  <tbody>
    <% resources.each do |work| %>
      <tr>
        <td>
          <%= link_to work.id, work_path(work_id: work.id), target: "_blank" %>
        </td>
        <td>
          <%= Deprecated::Badges::WorkMediaBadgeComponent.new(self, work: work).render %>
          <br>
          <%= work.title %>
          <br>
          <%= work.title_kana.presence || "-" %>
          <br>
          <%= work.title_en.presence || "-" %>
        </td>
        <td>
          <dl>
            <dt>しょぼかる</dt>
            <dd>
              <%= render SyobocalLinkComponent.new(work: work) %>
            </dd>
            <dt>MyAnimeList</dt>
            <dd>
              <%= render MalLinkComponent.new(work: work) %>
            </dd>
          </dl>
        </td>
        <td>
          <%= work.watchers_count %>
        </td>
        <td>
          <%= work.release_season.presence || "-" %>
        </td>
        <td>
          <%= render Pictures::WorkPictureComponent.new(work: work, width: 70) %>
        </td>
        <td>
          <%= render Db::PublishingStateLabelComponent.new(resource: work) %>
        </td>
        <td>
          <%# Every action links to a screen on the Go version rather than submitting from here:
              the write endpoints verify a CSRF token this page cannot produce, so the Go
              confirmation screens carry the form that performs the change. Each link repeats the
              same words on every row, so the target work is added to the accessible name and
              hidden visually. The confirmation links also carry this page as return_to, so
              cancelling or completing the change comes back to these search results.

              [Ja] どの操作もこの画面から送信せず Go 版の画面へのリンクにする。書き込みの
              エンドポイントはこの画面が用意できない CSRF トークンを検証するため、変更を実行する
              フォームは Go 版の確認画面が持つ。各リンクは行ごとに同じ文言を繰り返すため、対象の
              作品をアクセシブルネームに足し、表示上は隠す。確認画面へのリンクはこの画面を
              return_to として渡し、変更をやめた場合も完了した場合もこの検索結果に戻るようにする。 %>
          <% if policy(work).edit? %>
            <%= link_to "/db/works/#{work.id}/edit", class: "btn btn-primary btn-sm" do %>
              <%= t("noun.edit") %>
              <span class="visually-hidden"><%= t("messages.db.works.action_target_label", id: work.id) %></span>
            <% end %>
          <% end %>

          <% if policy(work).unpublish? %>
            <% if work.published? %>
              <%= link_to "/db/works/#{work.id}/archive/new?#{return_to_query}", class: "btn btn-warning btn-sm" do %>
                <%= t("noun.unpublish") %>
                <span class="visually-hidden"><%= t("messages.db.works.action_target_label", id: work.id) %></span>
              <% end %>
            <% else %>
              <%= link_to "/db/works/#{work.id}/unarchive/new?#{return_to_query}", class: "btn btn-success btn-sm" do %>
                <%= t("noun.publish") %>
                <span class="visually-hidden"><%= t("messages.db.works.action_target_label", id: work.id) %></span>
              <% end %>
            <% end %>
          <% end %>

          <% if policy(work).destroy? %>
            <%= link_to "/db/works/#{work.id}/deletion/new?#{return_to_query}", class: "btn btn-danger btn-sm" do %>
              <%= t("noun.delete") %>
              <span class="visually-hidden"><%= t("messages.db.works.action_target_label", id: work.id) %></span>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
