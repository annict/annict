# syntax=docker/dockerfile:1.7

FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# --- BuildKitのaptキャッシュ設定 ---
#
# aptの自動クリーンを無効化し、/var/cache/aptと /var/lib/aptのキャッシュマウントに
# 入った .debがレイヤーや再ビルドをまたいで残るようにして、aptキャッシュを温存する。
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
      > /etc/apt/apt.conf.d/keep-cache

# --- システムパッケージ ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu
apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  build-essential
  bubblewrap                # CodexのLinux sandboxに必要
  ca-certificates           # HTTPS接続に必要
  curl
  file                      # Shrineによる画像アップロードに必要 (Rails)
  fonts-noto-cjk            # headless chromiumのスクショ用の日本語 (CJK) フォント
  fzf                       # Claude Codeで使用
  git
  gnupg                     # PostgreSQL/Redis/StripeのGPGキーのdearmorに必要
  imagemagick               # Shrineによる画像アップロードに必要 (Rails)
  jq                        # Claude Codeで使用
  libasound2                # Playwright: ALSA音声ライブラリ
  libatk-bridge2.0-0        # Playwright: ATKブリッジ
  libatk1.0-0               # Playwright: ATK
  libcairo2                 # Playwright: 2Dグラフィックス
  libcups2                  # Playwright: 印刷システム
  libdrm2                   # Playwright: Direct Rendering Manager
  libffi-dev                # Ruby拡張のビルドに必要
  libgbm1                   # Playwright: Generic Buffer Management
  libglib2.0-0              # libvipsの依存パッケージ (Rails)
  libnspr4                  # Playwright: Netscape Portable Runtime
  libnss3                   # Playwright: Network Security Services
  libpango-1.0-0            # Playwright: テキストレンダリング
  libreadline-dev           # Rubyのreadline拡張に必要
  libssl-dev                # SSL関連のビルドに必要
  libvips42                 # 画像処理ライブラリ (Rails)
  libxcomposite1            # Playwright: X11 Composite拡張
  libxdamage1               # Playwright: X11 Damage拡張
  libxfixes3                # Playwright: X11 Fixes拡張
  libxkbcommon0             # Playwright: XKBキーボード処理
  libxrandr2                # Playwright: X11 RandR拡張
  libyaml-dev               # psych gemのインストールに必要 (Rails)
  lsb-release               # PostgreSQL/Redisのaptリポジトリ設定に必要
  nano                      # Claude Codeで使用
  net-tools                 # Claude Codeで使用netstat (ネットワークデバッグ用)
  procps                    # playwright-cli kill-all用のpsを提供
  psmisc                    # Claude Codeで使用fuser (プロセス特定用)
  python3                   # Claude Codeのアドホックなスクリプト実行で使用
  ripgrep                   # Claude Codeで使用
  sudo
  tree                      # Claude Codeで使用
  unzip
  vim                       # Claude Codeで使用
  zlib1g-dev                # Rubyのzlib拡張に必要
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- PostgreSQLクライアント ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg && \
    chmod 0644 /etc/apt/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt update && \
    apt install -y --no-install-recommends libpq-dev postgresql-client-17

# --- Redisツール ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://packages.redis.io/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/redis-archive-keyring.gpg && \
    chmod 0644 /etc/apt/keyrings/redis-archive-keyring.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $(lsb_release -cs) main" \
      > /etc/apt/sources.list.d/redis.list && \
    apt update && \
    apt install -y --no-install-recommends redis-tools=6:7.4.*

# --- Stripe CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://packages.stripe.dev/api/security/keypair/stripe-cli-gpg/public \
      | gpg --dearmor -o /etc/apt/keyrings/stripe.gpg && \
    chmod 0644 /etc/apt/keyrings/stripe.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/stripe.gpg] https://packages.stripe.dev/stripe-cli-debian-local stable main" \
      > /etc/apt/sources.list.d/stripe.list && \
    apt update && \
    apt install -y --no-install-recommends stripe

# --- mise (開発ツールバージョンマネージャー) ---
#
# Docker向けの推奨設定としてshims方式を使用する (PATHに /mise/shimsを含める)。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Go、Ruby、Node.js、pnpm、Yarnをmise経由でインストールする。
RUN mise install go@1.26.2 && \
    mise install ruby@3.3.10 && \
    mise install node@22.20.0 && \
    mise install node@22.17.0 && \
    mise install pnpm@10.17.1 && \
    mise install yarn@1.22.22

# グローバルデフォルトを設定する。
RUN mise use --global go@1.26.2 && \
    mise use --global ruby@3.3.10 && \
    mise use --global node@22.20.0 && \
    mise use --global pnpm@10.17.1

# --- dbmate ---
ARG DBMATE_VERSION=v2.33.0
ARG DBMATE_SHA256=dfd4027141b6e4357158099bdfe6c02b286af70f8e49057937744cf80b38ea1c
RUN curl -fsSL -o /tmp/dbmate "https://github.com/amacneil/dbmate/releases/download/${DBMATE_VERSION}/dbmate-linux-amd64" && \
    echo "${DBMATE_SHA256}  /tmp/dbmate" | sha256sum -c - && \
    mv /tmp/dbmate /usr/local/bin/dbmate && \
    chmod +x /usr/local/bin/dbmate

# --- hivemind ---
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -L -o /tmp/hivemind.gz "https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz" && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- golangci-lint ---
ARG GOLANGCI_LINT_VERSION=v2.11.4
ARG GOLANGCI_LINT_SHA256=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
RUN GOLANGCI_LINT_DIR="golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-amd64" && \
    curl -fsSL -o /tmp/golangci-lint.tar.gz "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/${GOLANGCI_LINT_DIR}.tar.gz" && \
    echo "${GOLANGCI_LINT_SHA256}  /tmp/golangci-lint.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp && \
    mv "/tmp/${GOLANGCI_LINT_DIR}/golangci-lint" /usr/local/bin/golangci-lint && \
    chmod +x /usr/local/bin/golangci-lint && \
    rm -rf "/tmp/golangci-lint.tar.gz" "/tmp/${GOLANGCI_LINT_DIR}"

# --- rclone ---
ARG RCLONE_VERSION=v1.74.3
ARG RCLONE_SHA256=dbee7ccd7a5d617e4ed4cd4555c16669b511abfe8d31164f61be35ac9e999bd2
RUN RCLONE_DIR="rclone-${RCLONE_VERSION}-linux-amd64" && \
    curl -fsSL -o /tmp/rclone.zip "https://github.com/rclone/rclone/releases/download/${RCLONE_VERSION}/${RCLONE_DIR}.zip" && \
    echo "${RCLONE_SHA256}  /tmp/rclone.zip" | sha256sum -c - && \
    unzip -q /tmp/rclone.zip -d /tmp && \
    mv "/tmp/${RCLONE_DIR}/rclone" /usr/local/bin/rclone && \
    chmod +x /usr/local/bin/rclone && \
    rm -rf "/tmp/rclone.zip" "/tmp/${RCLONE_DIR}"

# --- GitHub CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && \
    apt install -y --no-install-recommends gh

# --- 開発者ユーザーを作成する ---
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Goキャッシュディレクトリ ---
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- miseのデータディレクトリの権限設定 ---
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

# --- 1Password CLIの設定ディレクトリ ---
# 名前付きボリュームop-configをここにマウントする。Dockerがイメージ側の
# 所有権を引き継ぐのはボリュームが空で新規作成されたときだけのため、`op` が設定を
# 書き込めるよう開発者ユーザー所有のディレクトリを事前に用意しておく。
RUN install -d -o ${USER_ID} -g ${GROUP_ID} /home/${USERNAME}/.config && \
    install -d -o ${USER_ID} -g ${GROUP_ID} -m 0700 /home/${USERNAME}/.config/op

WORKDIR /workspace
USER ${USERNAME}

# --- miseのシェル設定 ---
#
# Docker環境ではshims方式を使用する (PATHに /mise/shimsを含めている)。
# mise activateはshimsをバイパスしてグローバルデフォルトの直接パスをPATHに
# 追加してしまい、ディレクトリごとのバージョン切り替えが効かなくなるため、
# ここでは実行しない。
RUN mise reshim

# --- 1Password CLI ---
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Codex ---
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# --- Playwright CLI ---
RUN npm install -g @playwright/cli@0.1.15 && \
    mise reshim && \
    playwright-cli install-browser chromium

# --- Goツール ---
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
ENV PATH="${GOPATH}/bin:${PATH}"
# イメージの再ビルドを再現可能にするため、ツールのバージョンを固定する
# (`@latest` は使わない)。curlで取得する上記のバイナリと異なりSHA256のARGは
# 不要 (ダウンロードの改ざん検証はGo module checksum DBが担保するため)。
RUN go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.30.0 && \
    go install github.com/air-verse/air@v1.65.3

# --- Rubyツール ---
RUN gem install bundler -v 2.3.12

# --- シェル設定 ---
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

RUN touch /home/${USERNAME}/.zshrc

# --- Git設定 ---
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
