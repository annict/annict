package components

import (
	"github.com/annict/annict/go/internal/templates"
	"github.com/annict/annict/go/internal/viewmodel"
)

// DBWorkSubnavData is the input for DBWorkSubnav.
//
// [Ja] DBWorkSubnavData は DBWorkSubnav の入力。
type DBWorkSubnavData struct {
	// WorkID is the work whose sub-resources the entries link to.
	//
	// [Ja] WorkID は各項目のリンク先サブリソースを持つ作品。
	WorkID viewmodel.WorkID
	// NoEpisodes drops the episode-derived entries (episodes, broadcast slots), mirroring
	// the Rails work subnav.
	//
	// [Ja] NoEpisodes はエピソード由来の項目 (エピソード・放送予定) を落とす (Rails の
	// 作品サブナビに合わせている)。
	NoEpisodes bool
}

// DBWorkSubnav renders the navigation shown above a work's DB form, linking to the work's
// sub-resources (episodes, programs, casts, and so on) as horizontal pills.
//
// The list holds up to eight entries, which do not fit on one line at small viewport
// widths, so it scrolls horizontally on its own rather than widening the document. Its
// links are focusable, so the keyboard reaches the entries that start out of view without
// the scroll container needing to take focus itself.
//
// Every destination except the work edit page itself is still served by Rails, so the
// flag-gated fallback routes those links to the Rails screens until they are migrated.
//
// [Ja] DBWorkSubnav は作品の DB フォームの上に表示するナビゲーションを描画し、作品の
// サブリソース (エピソード・番組情報・キャストなど) へのリンクを横並びのピルで並べる。
//
// 項目は最大 8 個あり小さい画面幅では 1 行に収まらないため、文書全体を広げるのではなく
// リスト自身を横スクロールさせる。リンクはフォーカス可能なので、スクロール領域自体が
// フォーカスを受け取らなくても画面外から始まる項目へキーボードで到達できる。
//
// 作品編集ページ自身を除くリンク先はまだ Rails が配信するため、フラグ配下のフォールバックが
// 移行までそれらを Rails 画面へ流す。
templ DBWorkSubnav(data DBWorkSubnavData) {
	<nav aria-label={ templates.T(ctx, "db_work_subnav_label") }>
		// The padding keeps the focus ring of a focused pill inside the scroll container,
		// which clips on both axes; the matching negative margin cancels it so the pills
		// still line up with the content above and below.
		//
		// [Ja] padding はフォーカスされたピルのフォーカスリングをスクロール領域内に収める
		// ためのもの (スクロール領域は上下左右とも内容を切る)。対になる負のマージンで打ち消し、
		// ピルは上下のコンテンツと揃ったままにする。
		<ul class="flex flex-nowrap gap-2 overflow-x-auto p-1 -m-1">
			@dbWorkSubnavItem(templates.DBWorkEditPath(data.WorkID), "db_work_subnav_work")
			if !data.NoEpisodes {
				@dbWorkSubnavItem(templates.DBWorkEpisodesPath(data.WorkID), "db_work_subnav_episodes")
			}
			@dbWorkSubnavItem(templates.DBWorkProgramsPath(data.WorkID), "db_work_subnav_programs")
			if !data.NoEpisodes {
				@dbWorkSubnavItem(templates.DBWorkSlotsPath(data.WorkID), "db_work_subnav_slots")
			}
			@dbWorkSubnavItem(templates.DBWorkCastsPath(data.WorkID), "db_work_subnav_casts")
			@dbWorkSubnavItem(templates.DBWorkStaffsPath(data.WorkID), "db_work_subnav_staffs")
			@dbWorkSubnavItem(templates.DBWorkImagePath(data.WorkID), "db_work_subnav_work_image")
			@dbWorkSubnavItem(templates.DBWorkTrailersPath(data.WorkID), "db_work_subnav_pv")
		</ul>
	</nav>
}

// dbWorkSubnavItem renders a single subnav pill, marking the entry as the current page
// (via aria-current) when its path matches the request path. The filled treatment of the
// current entry is driven by that same attribute, so the marker assistive technology reads
// and the one sighted users see cannot drift apart.
//
// [Ja] dbWorkSubnavItem はサブナビのピルを 1 つ描画し、リンク先がリクエストパスと一致する
// とき現在ページとして印を付ける (aria-current)。現在ページの塗りつぶしも同じ属性で切り替える
// ため、支援技術が読む印と目に見える印がずれることがない。
templ dbWorkSubnavItem(path templates.Path, labelKey string) {
	<li class="shrink-0">
		<a
			href={ path.SafeURL() }
			class="block rounded-full px-3 py-2 text-sm whitespace-nowrap transition-colors hover:bg-accent aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground aria-[current=page]:hover:bg-primary"
			if templates.IsCurrentPath(ctx, path.String()) {
				aria-current="page"
			}
		>
			{ templates.T(ctx, labelKey) }
		</a>
	</li>
}
