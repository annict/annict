package components

import "github.com/a-h/templ"

// MainTitleDataはメインタイトルコンポーネントに渡すデータ構造体です
type MainTitleData struct {
	Title    string
	Subtitle string
	Content  templ.Component
	Actions  templ.Component
}

// MainTitleはページのメインタイトルを表示します
templ MainTitle(data MainTitleData) {
	<div class="flex flex-col gap-4">
		<div class="flex flex-wrap md:flex-nowrap justify-between gap-2">
			// タイトルはデータ由来 (作品タイトルなど) のため、長く改行機会を持たないことが
			// ある。min-w-0で列がその固有幅より縮めるようにし、[overflow-wrap:anywhere] で
			// タイトルを折り返す。これにより行がページ内に収まり、文書が横に広がって操作が
			// 画面外へ押し出されるのを防ぐ。
			<div class="flex flex-col gap-2 min-w-0">
				<h1 class="flex min-w-0 items-center gap-2 text-2xl font-bold antialiased [overflow-wrap:anywhere]">
					{ data.Title }
				</h1>

				if data.Subtitle != "" {
					<div class="text-sm text-gray-600">
						{ data.Subtitle }
					</div>
				}

				if data.Content != nil {
					@data.Content
				}
			</div>

			if data.Actions != nil {
				<div class="flex w-full flex-none justify-end gap-2 md:w-auto">
					@data.Actions
				</div>
			}
		</div>
	</div>
}
