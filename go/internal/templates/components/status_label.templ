package components

import (
	"github.com/annict/annict/go/internal/templates"
	"github.com/annict/annict/go/internal/viewmodel"
)

// StatusLabelはAnnict DBのリソースの公開状態をバッジとして描画する。共有の
// viewmodel.PublishingStatusを受け取るため、ライフサイクルがpublished / archived /
// deletedのリソース (作品・エピソードなど) はいずれも同じ状態に同じバッジを表示する。
// 未知の値では空のバッジではなく何も描画しない。
templ StatusLabel(status viewmodel.PublishingStatus) {
	switch status {
		case viewmodel.PublishingStatusPublished:
			<span class="badge" data-variant="success">{ templates.T(ctx, "status_published") }</span>
		case viewmodel.PublishingStatusArchived:
			<span class="badge" data-variant="warning">{ templates.T(ctx, "status_archived") }</span>
		case viewmodel.PublishingStatusDeleted:
			<span class="badge" data-variant="destructive">{ templates.T(ctx, "status_deleted") }</span>
	}
}
