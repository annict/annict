package layouts

import (
	"github.com/annict/annict/go/internal/session"
	"github.com/annict/annict/go/internal/templates"
	"github.com/annict/annict/go/internal/templates/components"
	"github.com/annict/annict/go/internal/viewmodel"
)

// Db is the layout for the Annict DB admin UI, composed only of a sidebar and the main content area.
//
// [Ja] Db は Annict DB 管理画面用のレイアウト。サイドバーとメインコンテンツのみで構成される。
templ Db(meta viewmodel.PageMeta, assetVersion string, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(meta, assetVersion)
		</head>
		<body class="bg-background">
			@components.DBSidebar()

			// The sidebar's immediate next sibling is the whole background region: Basecoat
			// offsets it on desktop (.sidebar + *) and sidebar-toggle.ts marks it inert while
			// the mobile overlay is open. Flash lives inside it so its fixed toast (z-50, above
			// the z-40 overlay) is inert too, instead of staying reachable behind the overlay.
			//
			// [Ja] サイドバーの直後の兄弟が背面領域全体になる。Basecoat がデスクトップで余白を
			// 与え (.sidebar + *)、sidebar-toggle.ts がモバイルオーバーレイ表示中は inert にする。
			// Flash をこの内側に置くことで、その fixed トースト (z-50、z-40 のオーバーレイより前面)
			// も inert になり、オーバーレイ背面で操作可能なまま残らない。
			<div class="flex flex-col min-h-screen">
				<main>
					@content
				</main>

				@components.Flash(ctx, session.FlashFromContext(ctx))
			</div>
		</body>
	</html>
}
