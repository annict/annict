package two_factor_auth_notification

// JaHTMLは日本語版の二要素認証の設定の変更の通知メール (HTML形式) です
templ JaHTML(kind Kind) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>二要素認証の設定が変わりました</title>
		</head>
		<body style="font-family: sans-serif; line-height: 1.6; color: #333; padding: 20px;">
			switch kind {
				case KindEnabled:
					<p>Annictのアカウントで、二要素認証を有効にしました。</p>
					<p>これからは、パスワードやメールのコードでログインしたあとに、認証アプリのコードの入力を求めます。認証アプリを使えなくなったときは、有効にしたときに表示したリカバリーコードでログインできます。</p>
				case KindDisabled:
					<p>Annictのアカウントで、二要素認証を無効にしました。</p>
					<p>これからは、ログインのときに認証アプリのコードを求めません。発行していたリカバリーコードも使えなくなりました。</p>
				case KindDisabledByAdmin:
					<p>お問い合わせを受けて、管理者がAnnictのアカウントの二要素認証を無効にしました。</p>
					<p>これからは、ログインのときに認証アプリのコードを求めません。発行していたリカバリーコードも使えなくなりました。ログインしたあとに設定画面から、二要素認証を有効にし直せます。</p>
			}
			<p>この変更に心当たりがない場合は、第三者があなたのアカウントを使った可能性があります。Annictのパスワードを変更し、調査のため <a href="mailto:hello@annict.com">hello@annict.com</a> までお知らせください。</p>
		</body>
	</html>
}
