package db_works

import (
	"github.com/a-h/templ"

	"github.com/annict/annict/go/internal/templates"
)

// formLabelExternalLinkは作品フォームのラベル横に、フィールドにリンク先URLがあるとき
// 新しいタブで開く外部リンクアイコンを描画する。Railsの作品フォーム (URL / X / しょぼかる /
// MyAnimeListのラベル横に、値が入っていれば外部リンクアイコンを出す) に合わせている。新規・編集
// フォームで共有し、urlが空のときは何も描画しない。アイコンは装飾なので支援技術から隠し、リンク側に
// aria-labelを付ける。
templ formLabelExternalLink(label string, url string) {
	if url != "" {
		<a
			href={ templ.URL(url) }
			target="_blank"
			rel="noopener"
			aria-label={ templates.T(ctx, "db_works_form_external_link_label", map[string]any{"Field": label}) }
			class="text-primary hover:underline inline-flex items-center"
		>
			@templates.DecorativeIcon("arrow-square-out-regular", "w-[18px] h-[18px]")
		</a>
	}
}
