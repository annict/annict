package db_works

import (
	"github.com/annict/annict/go/internal/templates"
	"github.com/annict/annict/go/internal/templates/components"
	"github.com/annict/annict/go/internal/viewmodel"
)

// ArchiveNewPageData is the data the archive-confirmation page renders: the CSRF token,
// the target work's id (for the form action) and its title (for the confirmation prompt).
//
// [Ja] ArchiveNewPageData は非公開確認ページが描画するデータ (CSRF トークン、フォームの
// action に使う対象 work の id、確認文に使うタイトル)。
type ArchiveNewPageData struct {
	CSRFToken string
	WorkID    viewmodel.WorkID
	Title     string
}

templ ArchiveNew(data ArchiveNewPageData) {
	<div class="p-6">
		<div class="flex items-center justify-between mb-6">
			<div class="flex items-center gap-2">
				@components.DBSidebarToggle()
				<h1 class="text-2xl font-bold">{ templates.T(ctx, "db_works_archive_new_title") }</h1>
			</div>
			<a href={ templates.DBWorksPath().SafeURL() } class="btn" data-variant="outline" data-size="sm">
				{ templates.T(ctx, "db_works_archive_new_back_to_list_link") }
			</a>
		</div>

		<div class="max-w-2xl space-y-4">
			<p>{ templates.T(ctx, "db_works_archive_new_confirm_message", map[string]any{"Title": data.Title}) }</p>

			<form method="POST" action={ templates.DBWorkArchivePath(data.WorkID).SafeURL() } class="flex items-center gap-2">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<button type="submit" class="btn">
					{ templates.T(ctx, "db_works_archive_new_submit") }
				</button>
				<a href={ templates.DBWorksPath().SafeURL() } class="btn" data-variant="outline">
					{ templates.T(ctx, "db_works_archive_new_cancel_link") }
				</a>
			</form>
		</div>
	</div>
}
