package settings_two_factor_auth

import "github.com/annict/annict/go/internal/templates"

// CreatePageDataは、二要素認証を有効にした直後にリカバリーコードを示す画面に渡すデータ構造体です
type CreatePageData struct {
	// RecoveryCodesは発行したリカバリーコード
	RecoveryCodes []string
}

// Createは、二要素認証を有効にしたことを伝え、リカバリーコードを一度だけ示します。
//
// コードは保存していないため、この画面から離れると二度と表示できない。
// コードはまとめて選択してコピーできるよう、1行に1つずつのテキストとして並べる。
templ Create(data CreatePageData) {
	<div class="flex flex-col gap-4 py-4">
		<h1 class="text-2xl font-bold antialiased px-4">
			{ templates.T(ctx, "settings_two_factor_auth_create_heading") }
		</h1>
		<hr/>
		<div class="max-w-3xl w-full mx-auto flex flex-col gap-4 px-2 md:px-0">
			<div class="alert" data-variant="success" role="status">
				<h2>{ templates.T(ctx, "settings_two_factor_auth_create_enabled") }</h2>
			</div>
			<div class="card px-4">
				<div class="alert" data-variant="warning">
					<h2>{ templates.T(ctx, "settings_two_factor_auth_create_once_heading") }</h2>
					<section>{ templates.T(ctx, "settings_two_factor_auth_create_once_message") }</section>
				</div>
				<ul
					aria-label={ templates.T(ctx, "settings_two_factor_auth_create_codes_label") }
					class="grid grid-cols-2 gap-x-4 gap-y-1 rounded-lg border bg-muted p-4 font-mono select-all"
				>
					for _, code := range data.RecoveryCodes {
						<li>{ code }</li>
					}
				</ul>
				<p class="text-sm text-muted-foreground">
					{ templates.T(ctx, "settings_two_factor_auth_create_regenerate_help") }
				</p>
				<a href={ templ.SafeURL(ShowPath) } class="btn rounded-full w-fit">
					{ templates.T(ctx, "settings_two_factor_auth_create_done") }
				</a>
			</div>
		</div>
	</div>
}
